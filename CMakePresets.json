{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/build/match_director/${presetName}"
    },
    {
      "name": "debug-asan",
      "inherits": "base",
      "displayName": "Debug + ASAN + UBSAN",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MD_SANITIZER": "asan" }
    },
    {
      "name": "debug-tsan",
      "inherits": "base",
      "displayName": "Debug + TSAN",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MD_SANITIZER": "tsan" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (with debug info, for profiling)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "debug-asan", "configurePreset": "debug-asan" },
    { "name": "debug-tsan", "configurePreset": "debug-tsan" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "debug-asan", "configurePreset": "debug-asan", "output": { "outputOnFailure": true } },
    { "name": "debug-tsan", "configurePreset": "debug-tsan", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
